#!/bin/bash
set -euo pipefail

helper=/usr/bin/omarchy-plugin-workbench
# SHA-256 of the v0.4.0 reproducible x86_64 release helper. Update this only
# alongside a reviewed helper build and the corresponding package revision.
expected_sha256=4b40638081baddafaff0c33c38917bf841923aa7a92ba0b2b9f11e021bcf402f

if [[ ! -f $helper || ! -x $helper || -L $helper ]]; then
  echo "Plugin Workbench requires the reviewed omarchy-plugin-workbench helper package" >&2
  exit 69
fi

# The package location is root-managed. Checking the digest binds the normal
# QML invocation to the exact executable reviewed for this plugin revision.
actual_sha256="$(/usr/bin/sha256sum -- "$helper")"
actual_sha256="${actual_sha256%% *}"
if [[ $actual_sha256 != "$expected_sha256" ]]; then
  echo "Plugin Workbench helper digest mismatch; install the matching package before using this plugin" >&2
  exit 69
fi

exec "$helper" "$@"
