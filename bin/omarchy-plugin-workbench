#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "$script_dir/.." && pwd -P)"

if [[ -x /usr/bin/omarchy-plugin-workbench ]]; then
  exec /usr/bin/omarchy-plugin-workbench "$@"
elif [[ -x $repo_root/target/release/omarchy-plugin-workbench ]]; then
  exec "$repo_root/target/release/omarchy-plugin-workbench" "$@"
else
  echo "Plugin Workbench needs the omarchy-plugin-workbench package or a local release build" >&2
  exit 69
fi
