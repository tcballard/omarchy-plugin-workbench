#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
case "$(uname -m)" in
  x86_64)
    binary="$script_dir/omarchy-plugin-workbench-x86_64"
    ;;
  *)
    echo "Plugin Workbench supports official Omarchy x86-64 hosts only" >&2
    exit 69
    ;;
esac

if [[ ! -x $binary ]]; then
  echo "Plugin Workbench binary is missing or not executable: $binary" >&2
  exit 69
fi

exec "$binary" "$@"
