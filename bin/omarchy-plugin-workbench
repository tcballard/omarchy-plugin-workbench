#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
repo_root="$(cd -- "$script_dir/.." && pwd -P)"

# A local build belongs to this QML checkout. Refuse incompatible packaged
# helpers rather than silently combining different command contracts.
for helper in "$repo_root/target/release/omarchy-plugin-workbench" /usr/bin/omarchy-plugin-workbench; do
  [[ -x $helper ]] || continue
  if [[ $("$helper" protocol 2>/dev/null) == workbench-protocol-1 ]]; then
    exec "$helper" "$@"
  fi
done
echo "Plugin Workbench needs a helper supporting protocol 1; build this checkout with cargo build --locked --release" >&2
exit 69
